# Generated by iptables-save v1.8.7 (Hardened Bastion Profile - CIS Benchmark Compliant)
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# 1. Loopback Interface: Allow traffic on local loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# 2. Stateful Inspection: Allow established & related outbound connections
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A OUTPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# 3. Drop invalid connection states
-A INPUT -m conntrack --ctstate INVALID -j DROP

# 4. Anti-Spoofing: Drop RFC1918 private source IPs on public WAN interface eth0
-A INPUT -i eth0 -s 10.0.0.0/8 -j DROP
-A INPUT -i eth0 -s 172.16.0.0/12 -j DROP
-A INPUT -i eth0 -s 192.168.0.0/16 -j DROP
-A INPUT -i eth0 -s 127.0.0.0/8 -j DROP

# 5. ICMP / Ping Rate Limiting (Mitigate ping floods)
-A INPUT -p icmp --icmp-type echo-request -m limit --limit 1/s --limit-burst 4 -j ACCEPT
-A INPUT -p icmp -j DROP

# 6. Restricted Administrative Access (SSH): Only from corporate bastion management subnet
-A INPUT -s 10.200.10.0/24 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -j ACCEPT

# 7. Allowed Web Services (HTTPS only enforced, HTTP only for strict ACME/redirect)
-A INPUT -p tcp -m tcp --dport 80 -m conntrack --ctstate NEW -j ACCEPT
-A INPUT -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -j ACCEPT

# 8. Necessary Outbound DNS & NTP
-A OUTPUT -p udp -m udp --dport 53 -j ACCEPT
-A OUTPUT -p udp -m udp --dport 123 -j ACCEPT

# 9. Logging & Explicit Drop (CIS Audit logging)
-A INPUT -m limit --limit 5/min -j LOG --log-prefix "FW_INPUT_DROPPED: " --log-level 4
-A INPUT -j DROP
-A FORWARD -j DROP
-A OUTPUT -j DROP

COMMIT
