# Generated by iptables-save v1.8.7 (Corporate DMZ Dual-Homed Perimeter)
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# Loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Stateful inspection
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A OUTPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Forward traffic from WAN to DMZ Web Proxy
-A FORWARD -i eth0 -o eth1 -p tcp -d 172.16.1.10 --dport 443 -j ACCEPT
-A FORWARD -i eth0 -o eth1 -p tcp -d 172.16.1.10 --dport 80 -j ACCEPT

# Forward traffic from DMZ Web to Internal App Tier (Restricted port 8443)
-A FORWARD -i eth1 -o eth2 -s 172.16.1.10 -d 10.10.50.20 -p tcp --dport 8443 -j ACCEPT

# Administrative Jump Box access to DMZ management
-A INPUT -i eth2 -s 10.10.1.5 -p tcp --dport 22 -j ACCEPT

# Outbound DNS and NTP for DMZ gateway
-A OUTPUT -p udp -d 8.8.8.8 --dport 53 -j ACCEPT
-A OUTPUT -p udp -d 8.8.4.4 --dport 53 -j ACCEPT

COMMIT
