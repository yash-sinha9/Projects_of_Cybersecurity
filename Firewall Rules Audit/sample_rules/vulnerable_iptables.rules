# Generated by iptables-save v1.8.7 on Fri Sep 4 14:22:10 2026
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT

# Stateful established connections
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# INSECURE: Open SSH port 22 to the entire Internet without rate-limiting or restrictions
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT

# INSECURE: Cleartext Telnet port 23 open to all
-A INPUT -p tcp -m tcp --dport 23 -j ACCEPT

# Web server ports
-A INPUT -p tcp -m tcp --dport 80 -j ACCEPT
-A INPUT -p tcp -m tcp --dport 443 -j ACCEPT

# INSECURE: Database port 3306 exposed publicly to anywhere
-A INPUT -p tcp -m tcp --dport 3306 -j ACCEPT

# INSECURE: Redis unprotected port exposed
-A INPUT -p tcp -m tcp --dport 6379 -j ACCEPT

# SHADOWED RULE: This rule drops port 22 from 198.51.100.50, but rule #3 already accepted ALL traffic on port 22!
-A INPUT -s 198.51.100.50/32 -p tcp -m tcp --dport 22 -j DROP

# REDUNDANT RULE: Duplicate HTTP allow rule
-A INPUT -p tcp -m tcp --dport 80 -j ACCEPT

# Risky outbound egress: Any host can reach any destination on any port
-A OUTPUT -j ACCEPT

COMMIT
# Completed on Fri Sep 4 14:22:10 2026
